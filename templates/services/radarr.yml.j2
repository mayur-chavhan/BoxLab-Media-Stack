{#
  Radarr - Movie Automation
  Trash-Guides compliant configuration
  https://trash-guides.info/Radarr/
#}
  radarr:
    image: {{ services.radarr.image | default('lscr.io/linuxserver/radarr:latest') }}
    container_name: radarr
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ={{ timezone }}
      - UMASK=002
    volumes:
      # Config directory
      - {{ config_path }}/radarr:/config
      # Single data mount point for hardlinks (Trash-Guides best practice)
      - {{ data_path }}:/data
    ports:
      - {{ services.radarr.port | default(7878) }}:7878
    restart: unless-stopped
{% if services.radarr.depends_on %}
    depends_on:
{% for dependency in services.radarr.depends_on %}
      - {{ dependency }}
{% endfor %}
{% endif %}
