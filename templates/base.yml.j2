version: "3.8"

services:
{% for service in services %}
  {{ service.name }}:
    image: {{ service.image }}
    container_name: {{ service.name }}
    environment:
{% include 'snippets/common_env.j2' %}
{% if service.environment %}
{% for key, value in service.environment.items() %}
      - {{ key }}={{ value }}
{% endfor %}
{% endif %}
    volumes:
{% for volume in service.volumes %}
      - {{ volume.host_path }}:{{ volume.container_path }}{% if volume.read_only %}:ro{% endif %}

{% endfor %}
{% if service.ports %}
    ports:
{% for port in service.ports %}
      - {{ port.host_port }}:{{ port.container_port }}{% if port.protocol != 'tcp' %}/{{ port.protocol }}{% endif %}

{% endfor %}
{% endif %}
    restart: unless-stopped
{% if service.depends_on %}
    depends_on:
{% for dependency in service.depends_on %}
      - {{ dependency }}
{% endfor %}
{% endif %}
{% if not loop.last %}

{% endif %}
{% endfor %}

networks:
  default:
    name: {{ network_name | default('arr-stack') }}
